# No LLM API keys go here — users provide their own OpenAI/Anthropic key in the UI,
# per session, and it is never written to disk or logged by the backend.

# Port the combined server listens on inside the container
# (docker-compose maps host 8000 -> this port)
PORT=8000

# Host port used by Docker Compose. Change if port 8000 is already in use.
HOST_PORT=8000

# Comma-separated origins allowed for CORS. Only needed for local dev when running
# `npm run dev` (Vite on :5173) against `uvicorn --reload` (on :8000) as two separate
# processes. Leave unset for the docker-compose path (same-origin, no CORS needed).
CORS_ORIGINS=http://localhost:5173

# Max attempts the backend will retry the LLM if it returns invalid/malformed JSON
MAX_LLM_ATTEMPTS=3

# Max size (bytes) accepted for an uploaded threat model markdown file
MAX_THREAT_MODEL_BYTES=200000

# Durable local analysis storage. PostgreSQL URLs are also supported.
DATABASE_URL=sqlite:///./data/fault-tree-ai.db
